# Raw HSD scratch — never commit, deleted after every run anyway
work/

# Gridded scenes and masks carried between runs
state/

# Published outputs are built by Actions and committed to gh-pages,
# not to main. Keep the directory itself.
site/data/*
!site/data/.gitkeep

__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.env

# QA frames from smoke_mask --qa
qa/

# diagnostic scene cache (out-of-window scenes, kept deliberately)
state_diag/

# LinkedIn draft, not part of the pipeline
linkedin_post.txt
